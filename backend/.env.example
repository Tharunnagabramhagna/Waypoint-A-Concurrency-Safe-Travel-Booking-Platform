PORT=4000
DATABASE_URL=postgres://travel_user:travel_pass@localhost:5432/travel_booking
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another_long_random_string_different_from_access
JWT_REFRESH_EXPIRES_IN=7d
HOLD_TTL_SECONDS=600
CORS_ORIGIN=https://your-frontend-domain.vercel.app,http://localhost:5173
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_UPSTASH_HOST:6379
UPSTASH_REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_UPSTASH_HOST:6379
REDIS_TLS=true
# Optional if your provider expects username/password separately
# REDIS_USERNAME=default
# REDIS_PASSWORD=YOUR_UPSTASH_PASSWORD
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NODE_ENV=production
CSRF_SECRET=change_this_to_a_long_random_string

# Amadeus for Developers (https://developers.amadeus.com/)
# Sign up for a free self-service account to get your Client ID and Secret.
# If not set, the app works normally with DB/mock listings only.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers / Facebook (https://developers.facebook.com/)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Frontend URL for OAuth redirect
FRONTEND_URL=http://localhost:5173

# Resend Email API (https://resend.com)
# In production, use a verified domain e.g. "Waypoint Travel" <noreply@yourdomain.com>
# In testing/sandbox, "Waypoint Travel" <onboarding@resend.dev> delivers only to the Resend account owner
RESEND_API_KEY=
EMAIL_FROM=

# Google Gmail API Sender (OTP Delivery)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:4000/api/v1/auth/gmail/callback
GOOGLE_GMAIL_SENDER=
GOOGLE_GMAIL_REFRESH_TOKEN=



